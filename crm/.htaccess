Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.example\.php|schema\.php|bootstrap\.php|activity-log\.php|contract-safety\.php|account-management\.php|personnel-workflow\.php|README\.md|\.user\.ini)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(zip|sql|log|bak)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
